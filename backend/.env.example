# Copy to backend/.env for local development (backend/.env is gitignored — never commit it).
# Values below are placeholders for the local docker-compose database only.
DJANGO_DEBUG=true
# Required (no default in code). Generate one: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
POSTGRES_DB=leave_manager
POSTGRES_USER=leave_manager
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
